<%- include('partials/header') %>

<main style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <h1><%= title %></h1>

    <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        <div class="form-group" style="display: flex; flex-direction: column; gap: 5px;">
            <label for="name" style="font-weight: bold;">Organization Name</label>
            <input type="text" id="name" name="name" required maxlength="150" value="<%= organizationDetails.name %>" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px;" />
        </div>

        <div class="form-group" style="display: flex; flex-direction: column; gap: 5px;">
            <label for="description" style="font-weight: bold;">Description</label>
            <textarea id="description" name="description" rows="4" required maxlength="500" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px;"><%= organizationDetails.description %></textarea>
        </div>

        <div class="form-group" style="display: flex; flex-direction: column; gap: 5px;">
            <label for="contactEmail" style="font-weight: bold;">Contact Email</label>
            <input type="email" id="contactEmail" name="contactEmail" required value="<%= organizationDetails.contact_email %>" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px;" />
        </div>

        <div class="form-group" style="display: flex; flex-direction: column; gap: 5px;">
            <label for="logoFilename" style="font-weight: bold;">Logo Filename</label>
            <input type="text" id="logoFilename" name="logoFilename" required value="<%= organizationDetails.logo_filename %>" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px;" />
        </div>

        <button type="submit" style="background-color: #f59e0b; color: white; border: none; padding: 10px; border-radius: 4px; font-weight: bold; cursor: pointer;">
            Update Organization
        </button>
    </form>
</main>

<%- include('partials/footer') %>


