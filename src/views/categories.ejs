<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Explore our service projects by category:</p>
    <ul>
        <% categories.forEach(category => { %>
            <li style="margin-bottom: 10px;">
                <a href="/category/<%= category.category_id %>" style="font-weight: bold;"><%= category.category_name %></a>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
