<%- include('partials/header') %>

<main style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <h1><%= title %></h1>

    <form action="/edit-category/<%= category.category_id %>" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        <div class="form-group" style="display: flex; flex-direction: column; gap: 5px;">
            <label for="categoryName" style="font-weight: bold;">Category Name</label>
            <input type="text" id="categoryName" name="categoryName" required maxlength="100" value="<%= category.category_name %>" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px;" />
        </div>

        <button type="submit" style="background-color: #f59e0b; color: white; border: none; padding: 10px; border-radius: 4px; font-weight: bold; cursor: pointer;">
            Update Category
        </button>
    </form>
</main>

<%- include('partials/footer') %>
