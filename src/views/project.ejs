<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <% if (project) { %>
        <h2><%= project.title %></h2>
        <p><strong>Description:</strong> <%= project.description %></p>
        
        <% 
            const formattedDate = new Date(project.date).toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
            });
        %>
        <p><strong>Date:</strong> <%= formattedDate %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        
        <p><strong>Sponsoring Organization:</strong> 
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>

        <div class="project-categories" style="margin-top: 20px;">
            <strong>Categories:</strong>
            <% if (categories && categories.length > 0) { %>
                <div style="display: inline-flex; gap: 10px; margin-left: 5px;">
                    <% categories.forEach(cat => { %>
                        <a href="/category/<%= cat.category_id %>" style="background-color: #e2e8f0; color: #4a5568; padding: 4px 10px; border-radius: 15px; font-size: 0.85em; text-decoration: none; font-weight: bold;">
                            <%= cat.category_name %>
                        </a>
                    <% }); %>
                </div>
            <% } else { %>
                <span style="color: #a0aec0; font-style: italic;">No categories assigned</span>
            <% } %>
        </div>

        <!-- Enlace para editar y asignar categorías (W04) -->
        <p style="margin-top: 20px;">
            <a href="/assign-categories/<%= project.project_id %>" style="background-color: #4b5563; color: white; padding: 5px 12px; border-radius: 4px; text-decoration: none; font-size: 0.85em; font-weight: bold;">
                ⚙ Edit Categories
            </a>
        </p>

        <!-- Enlace para ir a Editar Proyecto (W04 Team Activity) -->
        <p style="margin-top: 15px;">
            <a href="/edit-project/<%= project.project_id %>" style="background-color: #f59e0b; color: white; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.85em; display: inline-block;">
                ✏ Edit Project Details
            </a>
        </p>

    <% } else { %>
        <p>Project details could not be found.</p>
    <% } %>

        <!-- VOLUNTEER INTERACTIVE COMPONENT (W06) -->
    <div style="margin-top: 30px; padding: 20px; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
        <% if (isLoggedIn) { %>
            <% if (isVolunteered) { %>
                <p style="color: #16a34a; font-weight: bold; font-size: 1.1em; margin-bottom: 10px;">
                    ✅ You are volunteering for this project!
                </p>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                    <button type="submit" style="background-color: #dc2626; color: white; padding: 8px 15px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">
                        ❌ Cancel My Volunteer Registration
                    </button>
                </form>
            <% } else { %>
                <p style="color: #475569; margin-bottom: 15px;">Would you like to support this service initiative?</p>
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit" style="background-color: #16a34a; color: white; padding: 10px 20px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 1em;">
                        🙋‍♂️ Volunteer for this Project
                    </button>
                </form>
            <% } %>
        <% } else { %>
            <p style="color: #64748b; margin: 0; font-style: italic;">
                Please <a href="/login" style="color: #2563eb; font-weight: bold; text-decoration: none;">Log In</a> to register as a volunteer for this project.
            </p>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
