<%- include('partials/header') %>

<main style="max-width: 600px; margin: 40px auto; padding: 20px; background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
    <h1 style="color: #1e3a8a;"><%= title %></h1>
    
    <div style="background-color: white; padding: 20px; border-radius: 6px; border: 1px solid #cbd5e1; margin-top: 20px;">
        <h2 style="margin-top: 0; color: #334155;">Welcome Back!</h2>
        <p style="font-size: 1.1em;"><strong>Name:</strong> <%= name %></p>
        <p style="font-size: 1.1em;"><strong>Username / Email:</strong> <%= email %></p>
    </div>

    <% if (userRole === 'admin') { %>
        <div style="margin-top: 30px; padding: 15px; background-color: #fef3c7; border: 1px solid #fde68a; border-radius: 6px;">
            <h3 style="margin-top: 0; color: #92400e;">Administrative Tools</h3>
            <p style="margin-bottom: 15px; color: #78350f;">As an administrator, you have access to the global user directory.</p>
            <a href="/users" style="background-color: #d97706; color: white; padding: 8px 15px; border-radius: 4px; text-decoration: none; font-weight: bold; display: inline-block;">
                Manage Registered Users
            </a>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
