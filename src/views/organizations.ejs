<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Here you will find a list of our partner organizations.</p>
    <ul class="organizations-list">
        <% organizations.forEach(organization => { %>
            <li style="display: flex; align-items: center; margin-bottom: 15px; gap: 15px;">
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" style="max-width: 50px; height: auto; border-radius: 4px;">
                <div>
                    <a href="/organization/<%= organization.organization_id %>" style="font-weight: bold; font-size: 1.1em;"><%= organization.name %></a>
                    <br>
                    <span>Contact: <%= organization.contact_email %></span>
                </div>
            </li>
        <% }) %>
    </ul>
</main>

<% if (userRole === 'admin') { %>
        <p style="margin-top: 30px;">
            <a href="/new-organization" style="background-color: #3b82f6; color: white; padding: 8px 15px; border-radius: 4px; text-decoration: none; font-weight: bold;">
                + Add a new organization
            </a>
        </p>
    <% } %>

<%- include('partials/footer') %>
