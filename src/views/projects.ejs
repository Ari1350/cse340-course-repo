<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Explore our upcoming service projects in your community.</p>

    <ul>
        <% projects.forEach(project => { %>
            <% 
                const formattedDate = new Date(project.date).toLocaleDateString('en-US', {
                    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
                });
            %>
            <li style="margin-bottom: 15px; line-height: 1.6; font-size: 1.05em;">
                <strong><%= formattedDate %>:</strong> 
                <a href="/project/<%= project.project_id %>" style="font-weight: bold;"><%= project.title %></a> 
                <span class="org-link">
                    ( <a href="/organization/<%= project.organization_id %>" style="font-style: italic;"><%= project.organization_name %></a> )
                </span>
            </li>
        <% }); %>
    </ul>
</main>

<% if (userRole === 'admin') { %>
       <p style="margin-top: 30px;">
           <a href="/new-project" style="background-color: #3b82f6; color: white; padding: 8px 15px; border-radius: 4px; text-decoration: none; font-weight: bold;">
               + Add a New Service Project
           </a>
       </p>
   <% } %>

<%- include('partials/footer') %>
