<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <nav>
        <ul style="display: flex; gap: 15px; list-style: none; padding: 0; align-items: center;">
        <li><a href="/">Home</a></li>
        <li><a href="/organizations">Organizations</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/categories">Categories</a></li>

        <!-- MENÚ DINÁMICO SEGÚN EL ESTADO DE INICIO DE SESIÓN (W05) -->
        <% if (isLoggedIn) { %>
            <li><a href="/logout" style="font-weight: bold; color: #dc2626;">Log Out</a></li>
        <% } else { %>
            <li><a href="/login" style="font-weight: bold; color: #10b981;">Log In</a></li>
            <li><a href="/register" style="font-weight: bold; color: #2563eb;">Register</a></li>
        <% } %>
        </ul>
    </nav>

    <nav>
    <ul style="display: flex; gap: 15px; list-style: none; padding: 0;">
        <li><a href="/">Home</a></li>
        <li><a href="/organizations">Organizations</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/categories">Categories</a></li>
        <li><a href="/register" style="font-weight: bold; color: #2563eb;">Register</a></li>
    </ul>
</nav>


    <!-- Bloque para mostrar mensajes Flash dinámicos (W04) -->
<% if (locals.flash) { %>
    <% const messages = flash(); %>
    <div class="flash-messages-container" style="max-width: 800px; margin: 15px auto; padding: 0 20px;">
        
        <% if (messages.success && messages.success.length > 0) { %>
            <% messages.success.forEach(msg => { %>
                <div style="background-color: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; padding: 12px 15px; border-radius: 4px; margin-bottom: 10px; font-weight: bold;">
                    ✓ <%= msg %>
                </div>
            <% }); %>
        <% } %>

        <% if (messages.error && messages.error.length > 0) { %>
            <% messages.error.forEach(msg => { %>
                <div style="background-color: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 12px 15px; border-radius: 4px; margin-bottom: 10px; font-weight: bold;">
                    ⚠️ <%= msg %>
                </div>
            <% }); %>
        <% } %>

    </div>
<% } %>
